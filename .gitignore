# ==========================================
# 5. Intentionally TRACKED (do not ignore!)
# ==========================================
# docs/ is the GitHub Pages site (viewer + .glb models) and must stay committed.

# Intermediate build product: the 15 m module kit is generated by
# tools/generate_building_modules.py, consumed by tools/assemble_buildings.py,
# and removed again before the site is published (see deploy.yml).
docs/models/modules/

# Local validation/browser tooling cache
.cache/

# Animated player build products: tools/retarget_animations.py regenerates
# characters/ and mirrors into docs/models/characters/. CI publishes them as a
# workflow artifact and stages them into _site for Pages -- they are never
# committed back (the base mesh itself, body_base_female_midpoly.*, IS tracked).
# (characters/base_mesh/ stays tracked -- that is where an artist uploads the
# AI-generated body the pipeline prefers over the committed fallback rig.)
/characters/player_animated.glb
/characters/player_animated.report.json
/characters/clothing/
docs/models/characters/player_animated.glb
docs/models/characters/player_animated.report.json
docs/models/characters/clothing/
