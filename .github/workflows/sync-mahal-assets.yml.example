# .github/workflows/sync-mahal-assets.yml.example
# ─────────────────────────────────────────────────
# Copy this file INTO YOUR GODOT GAME REPO as .github/workflows/sync-mahal-assets.yml
# It auto-downloads the latest Grand Mahal + modular buildings + terrain tiles from the
# indus-assets-gen GitHub Pages site and commits them to res://assets/downloaded_models/
# so your Godot export always uses fresh assets.
#
name: Sync Assets from indus-assets-gen

on:
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * *"  # daily 06:00 UTC
  repository_dispatch:
    types: [mahal-assets-updated]

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Download Mahal + buildings + terrain
        run: |
          BASE="https://lk0024709-ux.github.io/indus-assets-gen/models"
          mkdir -p assets/downloaded_models/terrain
          curl -L --fail -o assets/downloaded_models/rajasthani_mahal_mega.glb \
            "$BASE/mahal/rajasthani_mahal_mega.glb"
          for f in house_blue school_yellow apartment_green warehouse_metal cabin_wood \
                   ruined_building shop_row villa_white farmhouse_stone bunker_military tower_sniper; do
            curl -L --fail -o "assets/downloaded_models/${f}.glb" "$BASE/buildings_modular/${f}.glb"
          done
          for f in terrain_ground terrain_hill_large terrain_plateau terrain_valley; do
            curl -L --fail -o "assets/downloaded_models/terrain/${f}.glb" "$BASE/terrain/${f}.glb"
          done
          ls -lh assets/downloaded_models/ assets/downloaded_models/terrain/

      - name: Commit if changed
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore: sync mahal + modular buildings + terrain from indus-assets-gen"
          file_pattern: "assets/downloaded_models/**"
